# Copy to .env and fill locally. Do NOT commit .env.

MSSQL_SA_PASSWORD=Your_strong_Password123
Jwt__SigningKey=AIDR-Dev-Signing-Key-Change-Me-32chars!
Auth__FrontendResetPasswordUrl=http://localhost:5173/reset-password

# Google OAuth - paste from Google Cloud; keep secret out of git
# Redirect URI: http://localhost:8080/realms/aidr/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP - ưu tiên: dotnet user-secrets (AIDR.Api) cho Gmail App Password / SendGrid.
# Không commit mật khẩu. Mailhog chỉ khi test local không gửi mail thật.
# Smtp__Enabled=true
# Smtp__Host=smtp.gmail.com
# Smtp__Port=587
# Smtp__EnableSsl=true
# Smtp__Username=your.email@gmail.com
# Smtp__Password=your-16-char-app-password
# Smtp__From=your.email@gmail.com
# Smtp__FromDisplayName=AIDR
