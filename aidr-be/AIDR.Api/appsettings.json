    "Redis": "localhost:6379"
  },
  "Caching": {
    "UseInMemory": false
  },
  "Jwt": {
    "Issuer": "aidr-api",
    "Audience": "aidr-fe",
    "SigningKey": "AIDR-Dev-Signing-Key-Change-Me-32chars!"
