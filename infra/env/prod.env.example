# Copy lên VPS: /opt/aidr/.env  (chmod 600)
# Không commit file .env thật vào git.

DOMAIN=aidr.id.vn
API_IMAGE=aidr-api:local

# VPS 4 GB: giữ 1536; VPS 8 GB có thể tăng 2048–3072
MSSQL_MEMORY_LIMIT_MB=1536

# SQL Server (container trên VPS) - mật khẩu phải đủ mạnh (hoa/thường/số/ký tự)
MSSQL_SA_PASSWORD=ChangeMe_Strong_Passw0rd!

REDIS_PASSWORD=ChangeMe_Redis_Passw0rd!
KC_DB_PASSWORD=ChangeMe_KcDb_Passw0rd!
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=ChangeMe_KcAdmin_Passw0rd!

# JWT nội bộ (login email/password) - tối thiểu ~64 ký tự ngẫu nhiên
Jwt__SigningKey=REPLACE_WITH_LONG_RANDOM_STRING_AT_LEAST_64_CHARS_xxxxxxxxxxxx
Jwt__Issuer=aidr-api
Jwt__Audience=aidr-fe

# SMTP (bắt buộc production - không dùng Mailhog)
Smtp__Enabled=true
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=
Smtp__Password=
Smtp__From=noreply@aidr.id.vn
Smtp__FromDisplayName=AIDR

# payOS - để UseMock=true nếu chưa có key production
PayOS__UseMock=true
# PayOS__ClientId=
# PayOS__ApiKey=
# PayOS__ChecksumKey=
# PayOS__ReturnUrl=https://aidr.id.vn/order-received
# PayOS__CancelUrl=https://aidr.id.vn/order-received?cancelled=1

# Shipping / AI / eKYC - bật khi sẵn sàng
Shipping__Provider=None
Groq__UseMock=true

# eKYC: Gemini Vision (mặc định). KHÔNG dùng FptAi__UseMock nữa (đã chuyển sang Ekyc__*).
Ekyc__Provider=Gemini
Ekyc__UseMock=false
Ekyc__FaceMatchThreshold=0.80
Ekyc__ManualReviewThreshold=0.60
Ekyc__AllowedImageHosts__0=res.cloudinary.com
Gemini__BaseUrl=https://generativelanguage.googleapis.com/v1beta
Gemini__ApiKey=
Gemini__Model=gemini-3.5-flash-lite
Gemini__FallbackModel=gemini-3.6-flash
# Alternate: Ekyc__Provider=FptAi + FptAi__ApiKey=...
